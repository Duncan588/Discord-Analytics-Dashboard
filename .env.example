# Discord OAuth2
DISCORD_CLIENT_ID=your-oauth-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# 管理员 Discord User ID，多个使用逗号分隔
ADMIN_IDS=891196284998930522
# 白名单管理机器人 Token
DISCORD_BOT_TOKEN=your-whitelist-bot-token
# 默认 Discord 数据下载机器人 Token
DISCORD_DOWNLOADER_TOKEN=your-default-download-bot-token
# 兼容旧配置，可与 DISCORD_DOWNLOADER_TOKEN 相同
DISCORD_DOWNLOADER=
# Flask 会话密钥，留空时程序自动生成 data/.flask_secret
FLASK_SECRET_KEY=
PORT=5000
MAX_UPLOAD_BYTES=2147483648
PORTAL_DB=data/portal.db
# 生产填 https://你的域名（OAuth redirect_uri 用）；本地留空
PUBLIC_BASE_URL=
LEGACY_SERVER_ID=915249444721668096
FLASK_DEBUG=0

# 同时运行的独立下载任务数量（不同服务器建议 2-3）
DOWNLOAD_MAX_CONCURRENT_TASKS=3

# DiscordChatExporter 性能参数
# JSON 分析默认关闭 Markdown 处理，可提高导出速度
DCE_MARKDOWN=false
# 仅影响暂停/取消状态检查，不影响 Discord 下载吞吐量
DCE_PROCESS_POLL_MS=100
DCE_LOG_COMMAND=false
# 单个 DCE 进程批量导出的帖子数（1-50，默认 5）
DCE_BATCH_SIZE=5
# 单个 DCE 进程内并发导出的帖子数（1-10，默认 4；DCE 默认串行，调大可成倍提速）
DCE_PARALLEL_LIMIT=4

# ---- 生产主机 SSH（部署工具用）/ Production SSH (deploy tooling) ----
# v1.2 起已移除「云端数据库直连」模式：CLOUD_DB=1 会被忽略（仅打印一次警告），应用始终读本地 data/。
# 下面的 CLOUD_DB_SSH_* 仍供部署脚本做 ssh/scp；其余 CLOUD_DB_* 为兼容保留，不再生效。
CLOUD_DB=0
# 生产主机，例如 root@1.2.3.4
CLOUD_DB_SSH_TARGET=
# 可选：SSH 私钥路径
CLOUD_DB_SSH_KEY=
# 可选：SSH 端口（默认 22）
CLOUD_DB_SSH_PORT=
# 生产端部署目录
CLOUD_DB_REMOTE_ROOT=/root/v2/V20
# 本地仓库根；留空则自动取 app.py 所在目录
CLOUD_DB_LOCAL_ROOT=
# 生产端 Python 解释器
CLOUD_DB_REMOTE_PYTHON=python3
# （已废弃 / deprecated）
CLOUD_DB_AGENT=
# （已废弃 / deprecated）
CLOUD_DB_READONLY=1
# （已废弃 / deprecated）
CLOUD_DB_AGENT_ALLOW_WRITE=0

# ---- AI 机器人只读 API / AI bot read-only API (dixo/api.py) ----
# 逗号分隔的 Bearer token；留空 = /api/ai/v1 关闭（返回 404）。启用后后台会增量建 search.db 全文索引。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
AI_API_TOKENS=

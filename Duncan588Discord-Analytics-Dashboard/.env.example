# Discord OAuth2
DISCORD_CLIENT_ID=your-oauth-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# 管理员 Discord User ID，多个使用逗号分隔
ADMIN_IDS=891196284998930522
# 白名单管理机器人 Token
DISCORD_BOT_TOKEN=your-whitelist-bot-token
# 默认 Discord 数据下载机器人 Token
DISCORD_DOWNLOADER_TOKEN=your-default-download-bot-token
# 兼容旧配置，可与 DISCORD_DOWNLOADER_TOKEN 相同
DISCORD_DOWNLOADER=
# Flask 会话密钥，留空时程序自动生成 data/.flask_secret
FLASK_SECRET_KEY=
PORT=5000
MAX_UPLOAD_BYTES=2147483648
PORTAL_DB=data/portal.db
PUBLIC_BASE_URL=https://你的域名
LEGACY_SERVER_ID=915249444721668096
FLASK_DEBUG=0

# 同时运行的独立下载任务数量（不同服务器建议 2-3）
DOWNLOAD_MAX_CONCURRENT_TASKS=3

# DiscordChatExporter 性能参数
# JSON 分析默认关闭 Markdown 处理，可提高导出速度
DCE_MARKDOWN=false
# 仅影响暂停/取消状态检查，不影响 Discord 下载吞吐量
DCE_PROCESS_POLL_MS=100
DCE_LOG_COMMAND=false
# 单个 DCE 进程批量导出的帖子数（1-50，默认 5）
DCE_BATCH_SIZE=5
